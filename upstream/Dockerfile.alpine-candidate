# Public standalone build; reviewed official PHP security-release index.
ARG PHP_IMAGE=php:8.3.36-fpm-alpine@sha256:aaf1ad25fc6484613be770743d1038e98e3e7e07409d78b97410eccdf3628f75
FROM ${PHP_IMAGE}
RUN php -r 'if (PHP_MAJOR_VERSION !== 8 || PHP_MINOR_VERSION !== 3 || version_compare(PHP_VERSION, "8.3.36", "<")) { fwrite(STDERR, "This release requires patched PHP 8.3.36+ in the 8.3 branch.\n"); exit(1); }'
RUN apk upgrade --no-cache \
    && apk add --no-cache apache2 apache2-proxy apache2-ssl bash \
    && apk add --no-cache --virtual .redis-build $PHPIZE_DEPS \
    && curl --fail --location --proto '=https' --retry 3 --max-time 90 https://pecl.php.net/get/redis-6.1.0.tgz -o /tmp/redis-6.1.0.tgz \
    && echo 'f10405f639fe415e9ed4ec99538e72c90694d8dbd62868edcfcd6a453466b48c  /tmp/redis-6.1.0.tgz' | sha256sum -c - \
    && pecl install /tmp/redis-6.1.0.tgz \
    && rm /tmp/redis-6.1.0.tgz \
    && docker-php-ext-enable redis \
    && apk del .redis-build
COPY backend/ /speedtest/backend/
COPY *.js favicon.ico /speedtest/
COPY docker/standalone.php docker/health.php /speedtest/
COPY docker/entrypoint.sh /entrypoint.sh
COPY docker/speedtest-security.conf /etc/apache2/speedtest-security.conf
COPY docker/speedtest.ini /usr/local/etc/php/conf.d/speedtest.ini
COPY docker/alpine-candidate-httpd.conf /etc/apache2/httpd.conf
COPY docker/alpine-candidate-fpm.conf /usr/local/etc/php-fpm.d/zz-candidate.conf
COPY docker/alpine-candidate-run.sh /usr/local/bin/candidate-foreground
COPY assets/coffee-qr.svg /run/speedtest-assets/coffee-qr.svg
# Only replace the platform-specific process launcher; reuse upstream copying logic.
RUN sed -i 's/^apache2-foreground$/exec bash \/usr\/local\/bin\/candidate-foreground/' /entrypoint.sh
ENV MODE=standalone TELEMETRY=false DISABLE_IPINFO=true WEBPORT=80 TITLE=LibreSpeed
CMD ["bash", "/entrypoint.sh"]
